│   ├── documents/      # Gestión de documentos
│   ├── elements/       # Elementos UI reutilizables
│   ├── form/           # Componentes de formularios
│   ├── guards/         # Guards de autorización
│   ├── landing/        # Landing page components
│   ├── onboarding/     # Onboarding por rol
│   ├── parent-child/   # Relaciones padre-hijo
│   └── ui/             # Radix UI components
│
├── contexts/           # Context API
│   ├── AuthContext.jsx
│   ├── ClubContext.jsx
│   └── LoadingContext.jsx
│
├── hooks/              # Custom hooks
│   ├── useAuth.js
│   ├── useClub.js
│   └── usePermissions.js
│
├── pages/              # Páginas principales
│   ├── admin/          # Páginas de administración
│   ├── auth/           # Login, Register, Reset
│   ├── calendar/       # Página de calendario
│   ├── dashboard/      # Dashboards por módulo
│   │   ├── Categories/
│   │   ├── Chargers/
│   │   ├── ClubTeam/
│   │   ├── Discounts/
│   │   ├── Payments/
│   │   ├── Players/
│   │   └── Trainers/
│   ├── BlogPage.jsx
